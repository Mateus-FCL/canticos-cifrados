---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { lerChordpro } from '../../lib/chordpro';
import { palavrasDaLinha, soAcordes } from '../../lib/palavras';
import { batidasDaLinha, rotuloAndamento, temposPorCompasso } from '../../lib/rolagem';
import { rotuloBotaoTom } from '../../lib/rotulos';
import { NOME_MAX } from '../../lib/setlists';

export const getStaticPaths = (async () => {
  const canticos = await getCollection('canticos');
  return canticos.map((cantico) => ({ params: { id: cantico.id }, props: { cantico } }));
}) satisfies GetStaticPaths;

interface Props {
  cantico: CollectionEntry<'canticos'>;
}

const { cantico } = Astro.props;
const { numero, titulo, versoes } = cantico.data;
// Por enquanto mostra a primeira versão; escolher entre versões fica para depois.
const versao = versoes[0];
const secoes = versao ? lerChordpro(versao.chordpro) : [];
// Mapa de batidas da autorolagem: quanto tempo cada linha dura (ver lib/rolagem).
const tempos = temposPorCompasso(versao?.compasso ?? '4/4');
const tituloCompleto = numero === undefined ? titulo : `${numero} · ${titulo}`;
---

<Base titulo={titulo}>
  <a class="botao voltar" data-variante="secundario" href="/">← Voltar</a>

  <h1>{tituloCompleto}</h1>
  {versao && <p class="andamento">{rotuloAndamento(versao.compasso, versao.bpm)}</p>}

  <!-- Tom e tamanho precisam de JavaScript; sem ele, os botões não aparecem. -->
  <div class="acoes">
    <button type="button" class="botao abrir-tom" data-variante="primario" hidden>
      {rotuloBotaoTom(versao?.tom ?? '')}
    </button>
    <button type="button" class="botao abrir-tamanho" data-variante="secundario" hidden>Tamanho</button>
    <button type="button" class="botao abrir-setlists" data-variante="secundario" hidden>
      Adicionar à setlist
    </button>
    <button type="button" class="botao abrir-rolagem" data-variante="secundario" hidden>▶ Rolar a letra</button>
  </div>
  <p class="aviso-setlist" role="status" aria-live="polite"></p>

  <!-- A troca de modo só aparece com JavaScript; sem ele, fica letra e cifra. -->
  <div class="modos" role="group" aria-label="O que mostrar" hidden>
    <button type="button" class="modo" data-modo="cifra" aria-pressed="true">Letra e cifra</button>
    <button type="button" class="modo" data-modo="letra" aria-pressed="false">Só letra</button>
  </div>

  <!-- Busca no texto (Pagefind): só a letra entra no índice; acordes e títulos de seção ficam de fora. -->
  <article
    class="cifra desenho-cifra"
    data-modo="cifra"
    data-id={cantico.id}
    data-tom={versao?.tom}
    data-bpm={versao?.bpm}
    data-pagefind-body
    data-titulo={titulo}
    data-numero={numero}
    data-pagefind-meta="titulo[data-titulo], numero[data-numero]"
  >
    {
      secoes.map((secao) => (
        <section class:list={['secao', { refrao: secao.refrao }]}>
          {secao.titulo && <h2 class="titulo-secao" data-pagefind-ignore>{secao.titulo}</h2>}
          {secao.linhas.map((linha) => (
            <p
              class="linha"
              data-so-acordes={soAcordes(linha) ? '' : undefined}
              data-batidas={batidasDaLinha(linha, tempos)}
            >
              {palavrasDaLinha(linha).map((palavra) => (
                <>
                  <span class="palavra">
                    {palavra.map((peca) => (
                      <span class="peca">
                        <span
                          class:list={['acorde', { 'nao-acorde': peca.naoAcorde }]}
                          data-pagefind-ignore
                          data-acorde={peca.acorde && !peca.naoAcorde ? peca.acorde : undefined}
                        >
                          {peca.acorde ?? ''}
                        </span>
                        <span class="texto">{peca.texto}</span>
                      </span>
                    ))}
                  </span>{' '}
                </>
              ))}
            </p>
          ))}
        </section>
      ))
    }
  </article>

  <section class="corrigir" aria-labelledby="titulo-corrigir">
    <h2 id="titulo-corrigir">Achou um erro?</h2>
    <p>Na letra, num acorde ou no tom? Sugira a correção; uma pessoa responsável confere.</p>
    <a class="botao" data-variante="secundario" href={`/sugerir/?corrigir=${encodeURIComponent(cantico.id)}`}>
      Sugerir correção
    </a>
  </section>

  <dialog class="tela tela-tom" aria-labelledby="titulo-tom">
    <div class="tela-corpo">
      <div class="tela-cabecalho">
        <button type="button" class="botao voltar-tom" data-variante="secundario">← Voltar</button>
        <h2 id="titulo-tom">Trocar tom</h2>
      </div>

      <div class="painel-tom">
        <p class="rotulo-tom">Tom atual</p>
        <p class="tom-atual" role="status" aria-live="polite">{versao?.tom}</p>
        <p class="rotulo-tom">Tom original: {versao?.tom}</p>
      </div>

      <div class="passos">
        <button type="button" class="botao descer" data-variante="secundario">− Meio tom</button>
        <button type="button" class="botao subir" data-variante="primario">+ Meio tom</button>
      </div>

      <button type="button" class="botao original" data-variante="neutro">
        Voltar ao tom original ({versao?.tom})
      </button>

      <section class="previa" aria-labelledby="titulo-previa">
        <h3 class="titulo-previa" id="titulo-previa">Prévia</h3>
        <div class="previa-linhas desenho-cifra"></div>
      </section>
    </div>

    <div class="tela-rodape">
      <button type="button" class="botao concluir-tom" data-variante="primario">Concluído</button>
    </div>
  </dialog>

  <dialog class="tela tela-tamanho" aria-labelledby="titulo-tamanho">
    <div class="tela-corpo">
      <div class="tela-cabecalho">
        <button type="button" class="botao voltar-tamanho" data-variante="secundario">← Voltar</button>
      </div>
      <h2 id="titulo-tamanho">Tamanho da letra</h2>

      <section class="previa" aria-labelledby="titulo-previa-tamanho">
        <h3 class="titulo-previa" id="titulo-previa-tamanho">Prévia</h3>
        <div class="previa-tamanho desenho-cifra"></div>
      </section>

      <div class="controle-tamanho">
        <button type="button" class="botao menor" data-variante="secundario">
          A−<span class="visualmente-oculto"> diminuir a letra</span>
        </button>
        <p class="nivel" role="status" aria-live="polite"></p>
        <button type="button" class="botao maior" data-variante="primario">
          A+<span class="visualmente-oculto"> aumentar a letra</span>
        </button>
      </div>
      <div class="barra" aria-hidden="true"></div>
    </div>

    <div class="tela-rodape">
      <button type="button" class="botao concluir-tamanho" data-variante="primario">Concluído</button>
    </div>
  </dialog>

  <dialog class="tela tela-setlists" aria-labelledby="titulo-setlists">
    <div class="tela-corpo">
      <div class="tela-cabecalho">
        <button type="button" class="botao voltar-setlists" data-variante="secundario">← Voltar</button>
      </div>
      <h2 id="titulo-setlists">Adicionar à setlist</h2>
      <p class="explica">Marque as setlists em que “{titulo}” deve estar.</p>
      <p class="sem-setlists" hidden>Você ainda não tem setlists. Crie a primeira aqui embaixo.</p>
      <ul class="opcoes-marcar" aria-label="Suas setlists"></ul>

      <form class="nova-aqui" novalidate>
        <label for="nome-nova-setlist">Criar uma setlist nova</label>
        <div class="linha-nova">
          <input
            id="nome-nova-setlist"
            class="campo-texto"
            type="text"
            maxlength={NOME_MAX}
            autocomplete="off"
            enterkeyhint="done"
            placeholder="Por exemplo: Culto de domingo"
            aria-describedby="erro-nova-setlist"
          />
          <button type="submit" class="botao" data-variante="secundario">Criar</button>
        </div>
        <p id="erro-nova-setlist" class="mensagem-erro"></p>
      </form>
    </div>

    <div class="tela-rodape">
      <button type="button" class="botao concluir-setlists" data-variante="primario">Concluído</button>
    </div>
  </dialog>

  <!-- Autorolagem: aparece ao tocar em "Rolar a letra". -->
  <div slot="rodape" class="barra-rolagem" role="group" aria-label="Rolagem da letra" data-sempre-visivel hidden>
    <div class="topo-rolagem">
      <p class="estado-rolagem" role="status" aria-live="polite"></p>
      <button type="button" class="fechar-rolagem">Parar ✕</button>
    </div>
    <p class="detalhe-rolagem"></p>
    <button type="button" class="botao mais-devagar" data-variante="secundario">
      <span aria-hidden="true">−</span><span class="palavra-rolagem"> Devagar</span>
    </button>
    <button type="button" class="botao pausar-rolagem" data-variante="primario">
      <span class="icone-rolagem" aria-hidden="true">⏸</span><span class="palavra-rolagem"> Pausar</span>
    </button>
    <button type="button" class="botao mais-rapido" data-variante="secundario">
      <span aria-hidden="true">+</span><span class="palavra-rolagem"> Rápido</span>
    </button>
  </div>

  <!-- Só aparece quando o cântico foi aberto por uma setlist. -->
  <nav slot="rodape" class="nav-setlist" aria-label="Cânticos da setlist" hidden>
    <p class="nav-posicao"></p>
    <a class="botao nav-anterior" data-variante="secundario" hidden>← Anterior</a>
    <a class="botao nav-proximo" data-variante="primario" hidden>Próximo →</a>
    <a class="botao nav-fim" data-variante="primario" hidden>Voltar à setlist</a>
  </nav>

  <!-- Aviso antes da rolagem quando o cântico não tem BPM informado. -->
  <dialog class="aviso-bpm" aria-labelledby="titulo-aviso-bpm" aria-describedby="texto-aviso-bpm">
    <h2 id="titulo-aviso-bpm">Andamento não informado</h2>
    <p id="texto-aviso-bpm">
      Este cântico ainda não tem o BPM. A rolagem vai usar 100 BPM, que pode não ser o ritmo da música. Use
      “Devagar” e “Rápido” para ajustar.
    </p>
    <button type="button" class="botao entendi-bpm" data-variante="primario">Entendi</button>
  </dialog>

  <template class="modelo-opcao-setlist">
    <li>
      <label class="opcao">
        <input type="checkbox" />
        <span class="opcao-texto">
          <span class="opcao-nome"></span>
          <span class="opcao-detalhe"></span>
        </span>
      </label>
    </li>
  </template>
</Base>

<script>
  import { iniciarAdicionarASetlist } from '../../scripts/adicionar-setlist';
  import { iniciarNavegacaoNaSetlist } from '../../scripts/navegar-setlist';
  import { iniciarRolagem } from '../../scripts/rolagem';
  import { iniciarTamanho } from '../../scripts/tamanho';
  import { iniciarTrocaDeTom } from '../../scripts/tom';

  iniciarTamanho();
  iniciarTrocaDeTom();
  iniciarAdicionarASetlist();
  iniciarNavegacaoNaSetlist();
  iniciarRolagem();

  // Letra e cifra / Só letra. A escolha fica guardada neste aparelho.
  const CHAVE = 'canticos:modo';
  const grupo = document.querySelector<HTMLElement>('.modos');
  const cifra = document.querySelector<HTMLElement>('.cifra');
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('.modo')];

  const aplicar = (modo: string) => {
    if (!cifra) return;
    cifra.dataset['modo'] = modo;
    for (const b of botoes) b.setAttribute('aria-pressed', String(b.dataset['modo'] === modo));
  };

  if (grupo && cifra) {
    grupo.hidden = false;
    let salvo: string | null = null;
    try {
      salvo = localStorage.getItem(CHAVE);
    } catch {}
    if (salvo === 'letra' || salvo === 'cifra') aplicar(salvo);

    for (const botao of botoes) {
      botao.addEventListener('click', () => {
        const modo = botao.dataset['modo'] ?? 'cifra';
        aplicar(modo);
        try {
          localStorage.setItem(CHAVE, modo);
        } catch {}
      });
    }
  }

  // A tela não apaga enquanto o cântico está aberto (não é opção do usuário).
  let trava: WakeLockSentinel | null = null;
  const manterTelaAcesa = async () => {
    if (!('wakeLock' in navigator) || document.visibilityState !== 'visible') return;
    try {
      trava = await navigator.wakeLock.request('screen');
    } catch {
      // Sem permissão ou bateria fraca: segue sem travar a tela.
    }
  };
  // O navegador solta a trava quando a aba some; pede de novo ao voltar.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && (trava === null || trava.released)) void manterTelaAcesa();
  });
  void manterTelaAcesa();
</script>

<style>
  .voltar {
    margin-block: var(--espaco-4) var(--espaco-4);
  }

  h1 {
    font-size: var(--texto-titulo);
    margin-bottom: var(--espaco-4);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
    margin-bottom: var(--espaco-4);
  }

  .andamento {
    margin-top: calc(-1 * var(--espaco-3));
    margin-bottom: var(--espaco-4);
    color: var(--cor-texto-secundario);
  }

  /* Barra da autorolagem: estado em cima, três botões grandes embaixo. */
  .barra-rolagem {
    flex-wrap: wrap;
    gap: var(--espaco-2);
  }

  .topo-rolagem,
  .detalhe-rolagem {
    flex: 1 0 100%;
  }

  .topo-rolagem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-2);
  }

  .estado-rolagem {
    font-weight: var(--peso-forte);
  }

  .detalhe-rolagem {
    color: var(--cor-texto-secundario);
  }

  .fechar-rolagem {
    min-height: var(--alvo-toque);
    padding: 0 var(--espaco-2);
    border: 0;
    background: none;
    color: var(--cor-primaria);
    font-weight: var(--peso-forte);
    text-decoration: underline;
    cursor: pointer;
  }

  /* Os três sempre lado a lado; com pouco espaço, o símbolo fica em cima da palavra. */
  .barra-rolagem .botao {
    flex: 1 1 0;
    flex-wrap: wrap;
    column-gap: 0.3em;
    min-width: 0;
    padding-inline: var(--espaco-2);
  }

  .barra-rolagem .botao:disabled {
    border-color: var(--cor-borda);
    color: var(--cor-borda);
    cursor: default;
  }

  /* Letra grande (tela "baixa"): enquanto rola, só os três botões, com os símbolos.
     As palavras continuam para o leitor de tela. Pausado, o texto e o "Parar" voltam. */
  @media (max-height: 40em) {
    .palavra-rolagem {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .barra-rolagem:not([data-pausado]) .fechar-rolagem,
    .detalhe-rolagem {
      display: none;
    }

    /* Escondido só da vista: o leitor de tela continua anunciando o estado. */
    .barra-rolagem:not([data-pausado]) .topo-rolagem {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  /* Barra de baixo quando o cântico vem de uma setlist: posição em cima, botões embaixo. */
  .nav-setlist {
    flex-wrap: wrap;
    gap: var(--espaco-2) var(--espaco-3);
  }

  .nav-posicao {
    flex: 1 0 100%;
    color: var(--cor-texto-secundario);
    text-align: center;
  }

  .nav-setlist .botao {
    flex: 1 1 7em;
  }

  .aviso-setlist {
    margin-bottom: var(--espaco-4);
    padding: var(--espaco-3) var(--espaco-4);
    border-radius: var(--raio);
    background: var(--cor-superficie);
  }

  .aviso-setlist:empty {
    display: none;
  }

  .explica,
  .sem-setlists {
    color: var(--cor-texto-secundario);
  }

  .opcoes-marcar[hidden] {
    display: none;
  }

  .nova-aqui {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espaco-2);
    margin-top: var(--espaco-3);
  }

  .nova-aqui label {
    font-weight: var(--peso-forte);
  }

  .linha-nova {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2);
  }

  .linha-nova .campo-texto {
    flex: 1 1 10em;
    width: auto;
  }

  .linha-nova .botao {
    flex: 1 0 auto;
  }

  .acoes .botao {
    flex: 1 1 8em;
  }

  .acoes:not(:has(.botao:not([hidden]))) {
    display: none;
  }

  .painel-tom {
    padding: var(--espaco-4);
    border-radius: var(--raio);
    background: var(--cor-superficie);
    text-align: center;
  }

  .rotulo-tom {
    color: var(--cor-texto-secundario);
  }

  .tom-atual {
    font-size: calc(var(--texto-titulo-grande) * 2);
    font-weight: var(--peso-forte);
    line-height: 1.2;
    color: var(--cor-primaria);
  }

  .passos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
  }

  .passos .botao {
    flex: 1 1 7em;
  }

  .previa {
    padding: var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: var(--raio);
  }

  .titulo-previa {
    font-size: var(--texto-min);
    font-weight: var(--peso-normal);
    color: var(--cor-texto-secundario);
    margin-bottom: var(--espaco-2);
  }

  .modos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2);
    padding: var(--espaco-1);
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: var(--raio);
    margin-bottom: var(--espaco-4);
  }

  .modos[hidden] {
    display: none;
  }

  .modo {
    flex: 1 1 8em;
    min-height: var(--alvo-toque);
    padding: var(--espaco-2) var(--espaco-3);
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: calc(var(--raio) - 4px);
    background: var(--cor-superficie);
    font-weight: var(--peso-forte);
    cursor: pointer;
  }

  .modo[aria-pressed='true'] {
    border-color: var(--cor-primaria);
    background: var(--cor-primaria);
    color: var(--cor-sobre-primaria);
  }

  /* Aviso pequeno, no meio da tela (não ocupa a tela toda como Tom e Tamanho). */
  .aviso-bpm {
    width: min(100% - 32px, 28rem);
    padding: var(--espaco-5);
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: var(--raio);
    background: var(--cor-fundo);
    color: var(--cor-texto);
  }

  .aviso-bpm[open] {
    display: grid;
    gap: var(--espaco-4);
  }

  .aviso-bpm::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .aviso-bpm h2 {
    font-size: var(--texto-titulo);
  }

  .corrigir {
    display: grid;
    gap: var(--espaco-3);
    margin-block: var(--espaco-5);
    padding: var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-superficie);
    border-radius: var(--raio);
  }

  .corrigir h2 {
    font-size: var(--texto-corpo);
  }

  .corrigir p {
    color: var(--cor-texto-secundario);
  }

  /* A letra do cântico segue o nível escolhido (1 a 5), por cima da fonte do sistema. */
  .cifra {
    font-size: calc(var(--texto-corpo) * var(--escala-letra, 1));
  }

  .previa-tamanho {
    font-size: calc(var(--texto-corpo) * var(--escala-previa, 1));
    /* Nos níveis maiores, a prévia não empurra A− e A+ para fora da tela. */
    max-height: 40vh;
    overflow: hidden;
  }

  .controle-tamanho {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espaco-3);
  }

  .controle-tamanho .botao {
    flex: 1 1 4em;
    font-size: var(--texto-titulo);
  }

  .controle-tamanho .botao:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .nivel {
    flex: 1 1 5em;
    text-align: center;
    font-weight: var(--peso-forte);
    line-height: var(--entrelinha-titulo);
  }

  .barra {
    display: flex;
    gap: var(--espaco-2);
  }

  /* Os passos da barra são criados pelo script, por isso o :global. */
  .barra :global(span) {
    flex: 1;
    height: 12px;
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: 6px;
  }

  .barra :global(span[data-cheio]) {
    border-color: var(--cor-primaria);
    background: var(--cor-primaria);
  }

</style>
