---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { itensDaLista, normalizar } from '../lib/lista';
import { rotuloTom } from '../lib/rotulos';

const itens = itensDaLista(await getCollection('canticos'));
---

<Base titulo="Cânticos" aba="canticos">
  <h1>Cânticos</h1>

  <!-- Só aparece quando o navegador avisa que dá para instalar. -->
  <section class="instalar" aria-labelledby="titulo-instalar" hidden>
    <h2 id="titulo-instalar">Usar como app</h2>
    <p>Coloque o Cânticos na tela inicial do celular: abre mais rápido e em tela cheia.</p>
    <div class="instalar-botoes">
      <button type="button" class="botao instalar-sim" data-variante="primario">Instalar o app</button>
      <button type="button" class="botao instalar-nao" data-variante="secundario">Agora não</button>
    </div>
  </section>

  <!-- A busca só aparece com JavaScript; sem ele, a lista inteira continua acessível. -->
  <form class="busca" role="search" hidden>
    <label for="busca" class="visualmente-oculto">Buscar cântico</label>
    <input
      id="busca"
      type="search"
      placeholder="Buscar por número ou título"
      autocomplete="off"
      enterkeyhint="search"
    />
  </form>

  <p class="aviso-busca" role="status" aria-live="polite"></p>

  <ul class="lista" aria-label="Lista de cânticos">
    {
      itens.map((item) => (
        <li data-id={item.id} data-titulo={normalizar(item.titulo)} data-numero={item.numero ?? ''}>
          <a class="cartao" href={`/canticos/${item.id}/`}>
            <span class="conteudo">
              {item.numero !== undefined && (
                <span class="numero">
                  <span class="visualmente-oculto">Número </span>
                  {item.numero}
                </span>
              )}
              <span class="texto">
                <span class="titulo">{item.titulo}</span>
                <span class="tom">{rotuloTom(item.tom)}</span>
              </span>
            </span>
            <span class="seta" aria-hidden="true">
              ›
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Resultados pelo texto da letra (índice do Pagefind, gerado no build). -->
  <section class="na-letra" aria-labelledby="titulo-na-letra" hidden>
    <h2 id="titulo-na-letra">Encontrado na letra</h2>
    <ul class="lista resultados-letra"></ul>
  </section>

  <section class="sugerir" aria-labelledby="titulo-sugerir">
    <h2 id="titulo-sugerir">Não achou o cântico?</h2>
    <p>Sugira um cântico novo. Uma pessoa responsável confere antes de ele entrar no app.</p>
    <a class="botao link-sugerir" data-variante="secundario" href="/sugerir/">Sugerir um cântico</a>
  </section>

  <template class="modelo-resultado">
    <li>
      <a class="cartao">
        <span class="conteudo">
          <span class="numero">
            <span class="visualmente-oculto">Número </span>
            <span class="valor-numero"></span>
          </span>
          <span class="texto">
            <span class="titulo"></span>
            <span class="trecho"></span>
          </span>
        </span>
        <span class="seta" aria-hidden="true">›</span>
      </a>
    </li>
  </template>
</Base>

<script>
  import { avisoDaBusca, deveBuscarNaLetra, idDaUrl, partesDoTrecho } from '../lib/busca';
  import { corresponde } from '../lib/lista';
  import { iniciarConviteInstalar } from '../scripts/instalar';

  iniciarConviteInstalar();

  interface ResultadoPagefind {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
  }
  interface Pagefind {
    options(opcoes: object): Promise<void>;
    search(busca: string): Promise<{ results: { data(): Promise<ResultadoPagefind> }[] } | null>;
  }

  // O índice é gerado no build (e pelo "pnpm dev" ao iniciar). O endereço vai completo porque,
  // no "pnpm dev", o Vite acrescentaria "?import" a um caminho que começa com "/" e o arquivo não seria achado.
  const CAMINHO_PAGEFIND = new URL('/pagefind/pagefind.js', location.href).href;
  let pagefind: Promise<Pagefind | undefined> | undefined;
  const carregarPagefind = () =>
    (pagefind ??= import(/* @vite-ignore */ CAMINHO_PAGEFIND)
      .then(async (modulo: Pagefind) => {
        await modulo.options({ excerptLength: 14 });
        return modulo;
      })
      .catch(() => undefined));

  const secaoLetra = document.querySelector<HTMLElement>('.na-letra');
  const listaLetra = document.querySelector<HTMLUListElement>('.resultados-letra');
  const modeloResultado = document.querySelector<HTMLTemplateElement>('.modelo-resultado');

  /** Monta o cartão do resultado sem innerHTML: o trecho vira texto e <mark>. */
  const cartaoDoResultado = (id: string, dado: ResultadoPagefind) => {
    const li = modeloResultado!.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.querySelector('a')!.href = `/canticos/${id}/`;
    const numero = dado.meta['numero'];
    if (numero) li.querySelector('.valor-numero')!.textContent = numero;
    else li.querySelector('.numero')!.remove();
    li.querySelector('.titulo')!.textContent = dado.meta['titulo'] ?? id;
    li.querySelector('.trecho')!.replaceChildren(
      '…',
      ...partesDoTrecho(dado.excerpt).map((parte) => {
        if (!parte.destaque) return parte.texto;
        const mark = document.createElement('mark');
        mark.textContent = parte.texto;
        return mark;
      }),
      '…',
    );
    return li;
  };

  let pedido = 0;
  /** Busca na letra os cânticos que a busca por título não mostrou. */
  const buscarNaLetra = async (busca: string, jaMostrados: Set<string>): Promise<number> => {
    const meu = ++pedido;
    const limpar = () => {
      if (secaoLetra) secaoLetra.hidden = true;
      return 0;
    };
    if (!secaoLetra || !listaLetra || !modeloResultado || !deveBuscarNaLetra(busca)) return limpar();
    const pf = await carregarPagefind();
    const resposta = await pf?.search(busca);
    const dados = await Promise.all((resposta?.results ?? []).slice(0, 10).map((r) => r.data()));
    if (meu !== pedido) return -1; // a pessoa já digitou outra coisa
    const cartoes = dados.flatMap((dado) => {
      const id = idDaUrl(dado.url);
      return id && !jaMostrados.has(id) ? [cartaoDoResultado(id, dado)] : [];
    });
    listaLetra.replaceChildren(...cartoes);
    secaoLetra.hidden = cartoes.length === 0;
    return cartoes.length;
  };

  const form = document.querySelector<HTMLFormElement>('.busca');
  const campo = document.querySelector<HTMLInputElement>('#busca');
  const aviso = document.querySelector<HTMLParagraphElement>('.aviso-busca');
  const linhas = [...document.querySelectorAll<HTMLLIElement>('.lista > li')];
  const linkSugerir = document.querySelector<HTMLAnchorElement>('.link-sugerir')!;

  if (form && campo && aviso) {
    form.hidden = false;

    const filtrar = () => {
      const busca = campo.value;
      let visiveis = 0;
      const mostrados = new Set<string>();

      for (const li of linhas) {
        const numero = li.dataset['numero'];
        const mostra = corresponde(
          {
            id: '',
            titulo: li.dataset['titulo'] ?? '',
            tom: '',
            ...(numero ? { numero: Number(numero) } : {}),
          },
          busca,
        );
        li.hidden = !mostra;
        if (mostra) {
          visiveis++;
          mostrados.add(li.dataset['id'] ?? '');
        }
      }

      // "Sugerir um cântico" já leva o nome buscado (número sozinho não é nome).
      const nomeBuscado = busca.trim();
      linkSugerir.href =
        nomeBuscado && !/^\d+$/.test(nomeBuscado) ? `/sugerir/?titulo=${encodeURIComponent(nomeBuscado)}` : '/sugerir/';

      if (busca.trim() === '') {
        aviso.textContent = '';
        void buscarNaLetra('', mostrados);
        return;
      }
      // Número e título aparecem na hora; a letra completa o aviso logo depois.
      aviso.textContent = avisoDaBusca(visiveis, 0);
      clearTimeout(espera);
      espera = setTimeout(async () => {
        const naLetra = await buscarNaLetra(busca, mostrados);
        if (naLetra >= 0) aviso.textContent = avisoDaBusca(visiveis, naLetra);
      }, 300);
    };
    let espera: ReturnType<typeof setTimeout> | undefined;

    campo.addEventListener('input', filtrar);
    // Enter só fecha o teclado; a lista já está filtrada.
    form.addEventListener('submit', (evento) => {
      evento.preventDefault();
      campo.blur();
    });
    filtrar();
  }
</script>

<style>
  h1 {
    margin-block: var(--espaco-5) var(--espaco-4);
  }

  .busca input {
    width: 100%;
    min-height: var(--alvo-toque);
    padding: var(--espaco-2) var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-primaria);
    border-radius: var(--raio);
    background: var(--cor-fundo);
    font-size: var(--texto-corpo);
  }

  .busca input::placeholder {
    color: var(--cor-texto-secundario);
    opacity: 1;
  }

  .aviso-busca {
    margin-block: var(--espaco-3);
    color: var(--cor-texto-secundario);
  }

  .aviso-busca:empty {
    margin-block: var(--espaco-2);
  }

  .lista {
    display: grid;
    gap: var(--espaco-3);
    margin: 0;
    padding: 0 0 var(--espaco-4);
    list-style: none;
  }

  .cartao {
    display: flex;
    align-items: center;
    gap: var(--espaco-3);
    min-height: var(--alvo-toque);
    padding: var(--espaco-3) var(--espaco-4);
    border-radius: var(--raio);
    background: var(--cor-superficie);
    color: var(--cor-texto);
    text-decoration: none;
  }

  .conteudo {
    flex: 1;
    display: flex;
    flex-wrap: wrap; /* com letra grande, o número sobe para cima do título */
    align-items: center;
    gap: var(--espaco-3) var(--espaco-4);
    min-width: 0;
  }

  .numero {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 2em;
    min-height: 2em;
    padding: var(--espaco-1);
    border-radius: var(--raio);
    background: var(--cor-primaria);
    color: var(--cor-sobre-primaria);
    font-size: var(--texto-titulo);
    font-weight: var(--peso-forte);
    line-height: 1;
  }

  .texto {
    flex: 1 1 9em;
    display: grid;
    min-width: 0;
  }

  .titulo {
    font-size: var(--texto-titulo);
    font-weight: var(--peso-forte);
    line-height: var(--entrelinha-titulo);
  }

  .tom {
    color: var(--cor-texto-secundario);
  }

  .instalar {
    display: grid;
    gap: var(--espaco-3);
    margin-bottom: var(--espaco-4);
    padding: var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-primaria);
    border-radius: var(--raio);
  }

  .instalar[hidden] {
    display: none;
  }

  .instalar-botoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
  }

  .instalar-botoes .botao {
    flex: 1 1 8em;
  }

  .sugerir {
    display: grid;
    gap: var(--espaco-3);
    margin-block: var(--espaco-4);
    padding: var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-superficie);
    border-radius: var(--raio);
  }

  .sugerir h2 {
    font-size: var(--texto-corpo);
  }

  .sugerir p {
    color: var(--cor-texto-secundario);
  }

  .na-letra {
    display: grid;
    gap: var(--espaco-3);
    padding-bottom: var(--espaco-4);
  }

  .na-letra[hidden] {
    display: none;
  }

  .trecho {
    color: var(--cor-texto-secundario);
  }

  .trecho :global(mark) {
    background: var(--cor-aviso);
    color: var(--cor-texto);
    font-weight: var(--peso-forte);
  }

  .seta {
    flex: none;
    color: var(--cor-texto-secundario);
    font-size: var(--texto-titulo);
  }
</style>
