---
import '../styles/base.css';

interface Props {
  titulo: string;
  /** Aba marcada na barra inferior. Sem ela, a barra não aparece. */
  aba?: 'canticos' | 'setlists';
  /** A tela Sem internet já mostra o aviso fixo; as outras mostram só quando a internet cai. */
  avisoSemInternet?: boolean;
}

const { titulo, aba, avisoSemInternet = true } = Astro.props;

const abas = [
  { id: 'canticos', rotulo: 'Cânticos', href: '/' },
  { id: 'setlists', rotulo: 'Setlists', href: '/setlists/' },
] as const;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <!-- Sem maximum-scale nem user-scalable=no: a pessoa precisa poder ampliar. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b3a5c" />
    <meta name="description" content="Letras e cifras dos cânticos para o culto, com troca de tom e setlists." />
    <!-- Instalar na tela inicial: nome, cores e ícones ficam no manifesto. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icones/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Cânticos" />
    <title>{titulo === 'Cânticos' ? titulo : `${titulo} · Cânticos`}</title>
  </head>
  <body>
    <main class="pagina">
      {
        avisoSemInternet && (
          <p class="aviso-sem-internet" role="status" hidden>
            Sem internet. Os cânticos que você já abriu continuam disponíveis.
          </p>
        )
      }
      <slot />
    </main>
    {
      Astro.slots.has('rodape') && (
        <div class="rodape">
          <slot name="rodape" />
        </div>
      )
    }
    {
      aba && (
        <nav class="abas" aria-label="Seções do app">
          <ul>
            {abas.map((item) => (
              <li>
                <a
                  class="botao"
                  data-variante={item.id === aba ? 'primario' : 'secundario'}
                  href={item.href}
                  aria-current={item.id === aba ? 'page' : undefined}
                >
                  {item.rotulo}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </body>
</html>

<script>
  // Aviso amarelo quando a internet cai (e some quando ela volta).
  const aviso = document.querySelector<HTMLElement>('.aviso-sem-internet');
  if (aviso) {
    const atualizar = () => (aviso.hidden = navigator.onLine);
    window.addEventListener('online', atualizar);
    window.addEventListener('offline', atualizar);
    atualizar();
  }

  // Guarda o app no aparelho para funcionar sem internet. Só no build final:
  // no "pnpm dev" ele serviria páginas velhas enquanto você programa.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js', { type: 'module', updateViaCache: 'none' }).catch(() => {
      // Navegador sem suporte: o app continua funcionando, só que precisa de internet.
    });
  } else if ('serviceWorker' in navigator) {
    // No "pnpm dev", desliga o que um "pnpm preview" no mesmo endereço tenha deixado ligado.
    void navigator.serviceWorker.getRegistrations().then((registros) => registros.forEach((r) => r.unregister()));
  }
</script>

<style>
  .aviso-sem-internet {
    margin-bottom: var(--espaco-4);
    padding: var(--espaco-3) var(--espaco-4);
    border: var(--borda-largura) solid var(--cor-borda);
    border-radius: var(--raio);
    background: var(--cor-aviso);
    color: var(--cor-texto);
  }

  .aviso-sem-internet[hidden] {
    display: none;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  /* Barra fixa embaixo: abas, ou o botão principal de uma tela (ex.: "Abrir o primeiro cântico"). */
  .abas,
  .rodape {
    position: sticky;
    bottom: 0;
    background: var(--cor-superficie);
    padding: var(--espaco-3) var(--espaco-4);
  }

  /* Tela baixa para o tamanho da letra (ex.: fonte em 200%): a barra fixa cobriria
     metade da tela, então ela volta a ficar no fim da página. */
  @media (max-height: 40em) {
    .abas,
    .rodape {
      position: static;
    }

    /* Exceção: controles que a pessoa precisa alcançar a qualquer momento
       (ex.: Pausar a autorolagem) continuam fixos, mesmo com letra grande. */
    .rodape:has(> :global([data-sempre-visivel]:not([hidden]))) {
      position: sticky;
    }

    /* Para sobrar tela, só eles aparecem enquanto estão abertos. */
    .rodape:has(> :global([data-sempre-visivel]:not([hidden]))) > :global(:not([data-sempre-visivel])) {
      display: none;
    }
  }

  /* Rodapé sem nada visível (ex.: setlist vazia, rolagem fechada) some junto. */
  .rodape:not(:has(> :global(:not([hidden])))) {
    display: none;
  }

  .rodape > :global([hidden]) {
    display: none;
  }

  .rodape > :global(:not([hidden]) ~ :not([hidden])) {
    margin-top: var(--espaco-3);
  }

  .rodape > :global(*) {
    display: flex;
    width: 100%;
    max-width: var(--largura-max);
    margin-inline: auto;
  }

  .abas ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-3);
    max-width: var(--largura-max);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .abas li {
    flex: 1 1 8rem;
    display: flex;
  }

  .abas .botao {
    flex: 1;
  }
</style>
